# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local a Git (está en .gitignore).

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=tu_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Token de escritura (solo para el script de migración de noticias).
SANITY_API_WRITE_TOKEN=

# --- Formulario de contacto (Resend — https://resend.com) ---
RESEND_API_KEY=
CONTACT_EMAIL=coordinacioncdberriz@gmail.com

# --- Supabase (socios + login de empleados) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret: SOLO servidor. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (cuotas) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tarea programada de renovaciones (Vercel Cron) ---
CRON_SECRET=
